{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "EventTicketingPlatformDatabaseSchema",
  "description": "PostgreSQL relational database schema definition for the Event Ticketing Platform.",
  "version": "1.0.0",
  "tables": {
    "users": {
      "description": "User accounts with role-based access control.",
      "columns": {
        "id": { "type": "uuid", "primaryKey": true, "default": "gen_random_uuid()" },
        "email": { "type": "varchar(255)", "nullable": false, "unique": true },
        "password_hash": { "type": "text", "nullable": false },
        "name": { "type": "varchar(255)", "nullable": false },
        "role": { "type": "varchar(50)", "nullable": false, "enum": ["attendee", "organizer"] },
        "created_at": { "type": "timestamptz", "nullable": false, "default": "now()" },
        "updated_at": { "type": "timestamptz", "nullable": false, "default": "now()" }
      },
      "indexes": [
        { "name": "idx_users_email", "columns": ["email"], "unique": true }
      ]
    },
    "sessions": {
      "description": "Server-side user sessions for secure HTTP-only cookie authentication.",
      "columns": {
        "id": { "type": "uuid", "primaryKey": true, "default": "gen_random_uuid()" },
        "user_id": { "type": "uuid", "nullable": false, "references": "users(id)", "onDelete": "cascade" },
        "token": { "type": "varchar(255)", "nullable": false, "unique": true },
        "expires_at": { "type": "timestamptz", "nullable": false },
        "created_at": { "type": "timestamptz", "nullable": false, "default": "now()" }
      },
      "indexes": [
        { "name": "idx_sessions_token", "columns": ["token"], "unique": true },
        { "name": "idx_sessions_user_id", "columns": ["user_id"] }
      ]
    },
    "events": {
      "description": "Events created and managed by organizers.",
      "columns": {
        "id": { "type": "uuid", "primaryKey": true, "default": "gen_random_uuid()" },
        "organizer_id": { "type": "uuid", "nullable": false, "references": "users(id)", "onDelete": "restrict" },
        "title": { "type": "varchar(255)", "nullable": false },
        "description": { "type": "text", "nullable": false },
        "venue_name": { "type": "varchar(255)", "nullable": false },
        "venue_address": { "type": "text", "nullable": false },
        "event_date": { "type": "timestamptz", "nullable": false },
        "status": { "type": "varchar(50)", "nullable": false, "default": "'draft'", "enum": ["draft", "published", "cancelled", "completed"] },
        "is_high_demand": { "type": "boolean", "nullable": false, "default": false },
        "created_at": { "type": "timestamptz", "nullable": false, "default": "now()" },
        "updated_at": { "type": "timestamptz", "nullable": false, "default": "now()" }
      },
      "indexes": [
        { "name": "idx_events_organizer_id", "columns": ["organizer_id"] },
        { "name": "idx_events_event_date", "columns": ["event_date"] },
        { "name": "idx_events_status", "columns": ["status"] }
      ]
    },
    "sections": {
      "description": "Seating layout sections with pricing tiers.",
      "columns": {
        "id": { "type": "uuid", "primaryKey": true, "default": "gen_random_uuid()" },
        "event_id": { "type": "uuid", "nullable": false, "references": "events(id)", "onDelete": "cascade" },
        "name": { "type": "varchar(100)", "nullable": false },
        "price": { "type": "integer", "nullable": false, "description": "Price in smallest currency unit (e.g., paise/cents), non-negative" },
        "rows_count": { "type": "integer", "nullable": false },
        "seats_per_row": { "type": "integer", "nullable": false },
        "created_at": { "type": "timestamptz", "nullable": false, "default": "now()" }
      },
      "indexes": [
        { "name": "idx_sections_event_id", "columns": ["event_id"] }
      ]
    },
    "seats": {
      "description": "Individual seats generated based on section layout configuration.",
      "columns": {
        "id": { "type": "uuid", "primaryKey": true, "default": "gen_random_uuid()" },
        "event_id": { "type": "uuid", "nullable": false, "references": "events(id)", "onDelete": "cascade" },
        "section_id": { "type": "uuid", "nullable": false, "references": "sections(id)", "onDelete": "cascade" },
        "row_label": { "type": "varchar(10)", "nullable": false },
        "seat_number": { "type": "integer", "nullable": false },
        "seat_label": { "type": "varchar(50)", "nullable": false },
        "created_at": { "type": "timestamptz", "nullable": false, "default": "now()" }
      },
      "constraints": [
        {
          "name": "uq_seats_event_section_row_number",
          "type": "unique",
          "columns": ["event_id", "section_id", "row_label", "seat_number"]
        }
      ],
      "indexes": [
        { "name": "idx_seats_event_id", "columns": ["event_id"] },
        { "name": "idx_seats_section_id", "columns": ["section_id"] }
      ]
    },
    "bookings": {
      "description": "Orders representing attendee purchases.",
      "columns": {
        "id": { "type": "uuid", "primaryKey": true, "default": "gen_random_uuid()" },
        "user_id": { "type": "uuid", "nullable": false, "references": "users(id)", "onDelete": "restrict" },
        "event_id": { "type": "uuid", "nullable": false, "references": "events(id)", "onDelete": "restrict" },
        "total_amount": { "type": "integer", "nullable": false, "description": "Total amount in smallest currency unit" },
        "status": { "type": "varchar(50)", "nullable": false, "default": "'pending'", "enum": ["pending", "confirmed", "cancelled", "refunded"] },
        "razorpay_order_id": { "type": "varchar(100)", "nullable": true, "unique": true },
        "razorpay_payment_id": { "type": "varchar(100)", "nullable": true },
        "created_at": { "type": "timestamptz", "nullable": false, "default": "now()" },
        "updated_at": { "type": "timestamptz", "nullable": false, "default": "now()" }
      },
      "indexes": [
        { "name": "idx_bookings_user_id", "columns": ["user_id"] },
        { "name": "idx_bookings_event_id", "columns": ["event_id"] },
        { "name": "idx_bookings_razorpay_order_id", "columns": ["razorpay_order_id"], "unique": true }
      ]
    },
    "confirmed_seats": {
      "description": "Critical table enforcing zero double bookings via strict unique database constraint.",
      "columns": {
        "id": { "type": "uuid", "primaryKey": true, "default": "gen_random_uuid()" },
        "event_id": { "type": "uuid", "nullable": false, "references": "events(id)", "onDelete": "restrict" },
        "seat_id": { "type": "uuid", "nullable": false, "references": "seats(id)", "onDelete": "restrict" },
        "booking_id": { "type": "uuid", "nullable": false, "references": "bookings(id)", "onDelete": "restrict" },
        "price": { "type": "integer", "nullable": false, "description": "Confirmed purchase price in smallest currency unit" },
        "created_at": { "type": "timestamptz", "nullable": false, "default": "now()" }
      },
      "constraints": [
        {
          "name": "uq_confirmed_seats_event_seat",
          "type": "unique",
          "columns": ["event_id", "seat_id"]
        }
      ],
      "indexes": [
        { "name": "idx_confirmed_seats_booking_id", "columns": ["booking_id"] },
        { "name": "idx_confirmed_seats_event_id", "columns": ["event_id"] }
      ]
    },
    "tickets": {
      "description": "Signed digital QR tickets issued to attendees for venue scanning.",
      "columns": {
        "id": { "type": "uuid", "primaryKey": true, "default": "gen_random_uuid()" },
        "booking_id": { "type": "uuid", "nullable": false, "references": "bookings(id)", "onDelete": "cascade" },
        "seat_id": { "type": "uuid", "nullable": false, "references": "seats(id)", "onDelete": "restrict" },
        "event_id": { "type": "uuid", "nullable": false, "references": "events(id)", "onDelete": "restrict" },
        "user_id": { "type": "uuid", "nullable": false, "references": "users(id)", "onDelete": "restrict" },
        "ticket_code": { "type": "varchar(255)", "nullable": false, "unique": true },
        "status": { "type": "varchar(50)", "nullable": false, "default": "'issued'", "enum": ["issued", "used", "refunded"] },
        "scanned_at": { "type": "timestamptz", "nullable": true },
        "scanned_by": { "type": "uuid", "nullable": true, "references": "users(id)", "onDelete": "set null" },
        "created_at": { "type": "timestamptz", "nullable": false, "default": "now()" },
        "updated_at": { "type": "timestamptz", "nullable": false, "default": "now()" }
      },
      "indexes": [
        { "name": "idx_tickets_ticket_code", "columns": ["ticket_code"], "unique": true },
        { "name": "idx_tickets_booking_id", "columns": ["booking_id"] },
        { "name": "idx_tickets_user_id", "columns": ["user_id"] },
        { "name": "idx_tickets_event_id", "columns": ["event_id"] }
      ]
    },
    "refunds": {
      "description": "Audit record for cancelled bookings and processed refunds.",
      "columns": {
        "id": { "type": "uuid", "primaryKey": true, "default": "gen_random_uuid()" },
        "booking_id": { "type": "uuid", "nullable": false, "references": "bookings(id)", "onDelete": "restrict" },
        "user_id": { "type": "uuid", "nullable": false, "references": "users(id)", "onDelete": "restrict" },
        "amount": { "type": "integer", "nullable": false, "description": "Refunded amount in smallest currency unit" },
        "reason": { "type": "text", "nullable": true },
        "status": { "type": "varchar(50)", "nullable": false, "default": "'completed'", "enum": ["pending", "completed", "failed"] },
        "razorpay_refund_id": { "type": "varchar(100)", "nullable": true },
        "created_at": { "type": "timestamptz", "nullable": false, "default": "now()" }
      },
      "indexes": [
        { "name": "idx_refunds_booking_id", "columns": ["booking_id"] },
        { "name": "idx_refunds_user_id", "columns": ["user_id"] }
      ]
    },
    "webhook_events": {
      "description": "Log of external webhook payloads ensuring idempotent processing.",
      "columns": {
        "id": { "type": "uuid", "primaryKey": true, "default": "gen_random_uuid()" },
        "event_id": { "type": "varchar(255)", "nullable": false, "unique": true, "description": "Provider webhook event ID (e.g., x-razorpay-event-id)" },
        "event_type": { "type": "varchar(100)", "nullable": false },
        "payload": { "type": "jsonb", "nullable": false },
        "status": { "type": "varchar(50)", "nullable": false, "enum": ["processed", "failed", "ignored"] },
        "processed_at": { "type": "timestamptz", "nullable": false, "default": "now()" }
      },
      "indexes": [
        { "name": "idx_webhook_events_event_id", "columns": ["event_id"], "unique": true }
      ]
    }
  }
}
